# ============================================
# ClawBuddy Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -------------------------------------------
# Supabase (Required)
# -------------------------------------------
# Your Supabase project URL and keys
# Get these from: https://supabase.com/dashboard > Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase access token (for CLI deployments)
# Get from: https://supabase.com/dashboard > Account > Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_your-access-token-here

# -------------------------------------------
# License (Required)
# -------------------------------------------
# Get your activation code from: https://www.skool.com/aibox/about
# Run the activation curl command (see SETUP.md Step 4)
CLAWBUDDY_LICENSE_TOKEN=cb_your-license-token-here
LICENSE_VERIFY_KEY=your-verify-key-here

# -------------------------------------------
# ClawBuddy API (Required)
# -------------------------------------------
# Webhook secret for authenticating agent requests
# Generate a strong random string (e.g., openssl rand -hex 32)
CLAWBUDDY_API_URL=https://YOUR_PROJECT_REF.supabase.co
CLAWBUDDY_WEBHOOK_SECRET=your-webhook-secret-here

# -------------------------------------------
# AI Tasks API Key (Required)
# -------------------------------------------
# Used by automation-runner and other internal functions
# Generate a strong random string
AI_TASKS_API_KEY=your-api-key-here

# -------------------------------------------
# Agent Identity (Required)
# -------------------------------------------
# Your agent's display name and emoji on the dashboard
AGENT_NAME=MyAgent
AGENT_EMOJI=🤖

# -------------------------------------------
# AgentMail (Optional -- for email delivery)
# -------------------------------------------
# Sign up at: https://agentmail.to
AGENTMAIL_API_KEY=your-agentmail-api-key-here
AGENTMAIL_INBOX=youragent@agentmail.to

# -------------------------------------------
# OpenAI (Optional -- for Sherlock Brain & Research)
# -------------------------------------------
# Used by sherlock-brain for Brain Reports
# Used by browser-research for AI summarization
OPENAI_API_KEY=sk-your-openai-key-here

# -------------------------------------------
# Make.com (Optional -- for Calendar Sync)
# -------------------------------------------
# Used by calendar-sync to bridge with Google Calendar
# Get from: Make.com > Profile > API
MAKE_API_TOKEN=your-make-api-token-here

# -------------------------------------------
# Resend (Optional -- for direct email delivery)
# -------------------------------------------
# Alternative to AgentMail for email automation channels
RESEND_API_KEY=re_your-resend-key-here

# -------------------------------------------
# Telegram Bot (Optional -- for Telegram delivery)
# -------------------------------------------
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# -------------------------------------------
# Frontend (Optional -- if self-hosting dashboard)
# -------------------------------------------
# Used by the React frontend (Vite env vars)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_CLAWBUDDY_WEBHOOK_SECRET=your-webhook-secret-here
